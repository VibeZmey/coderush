name: coderush

x-logging: &default-logging
  logging:
    driver: json-file
    options:
      max-size: 100m

services:
  frontend:
    build:
      context: ./frontend
    ports:
      - "127.0.0.1:${FRONTEND_PORT:-8443}:443"
    volumes:
      - frontend_certs:/etc/nginx/certs
    depends_on:
      api:
        condition: service_started
    networks:
      - app

  # ---------- Твоё приложение ----------
  api:
    build:
      context: ./backend
      dockerfile: Api/Dockerfile
    environment:
      ASPNETCORE_ENVIRONMENT: ${ASPNETCORE_ENVIRONMENT:?Set ASPNETCORE_ENVIRONMENT in .env}
      ASPNETCORE_HTTP_PORTS: 8080
      Security__HttpsTerminatedByProxy: "true"
      ConnectionStrings__DefaultConnection: ${ConnectionStrings__DefaultConnection:?Set ConnectionStrings__DefaultConnection in .env}
      Judge0__BaseUrl: http://judge0-server:2358
      ProfileMedia__Endpoint: http://minio:9000
      ProfileMedia__Bucket: ${MINIO_PROFILE_BUCKET:?Set MINIO_PROFILE_BUCKET in .env}
      ProfileMedia__AccessKey: ${MINIO_PROFILE_ACCESS_KEY:?Set MINIO_PROFILE_ACCESS_KEY in .env}
      ProfileMedia__SecretKey: ${MINIO_PROFILE_SECRET_KEY:?Set MINIO_PROFILE_SECRET_KEY in .env}
    ports:
      - "127.0.0.1:${API_PORT:?Set API_PORT in .env}:8080"
    depends_on:
      postgres:
        condition: service_healthy
      judge0-server:
        condition: service_started
      minio-init:
        condition: service_completed_successfully
    networks:
      - app
      - storage

  minio:
    image: ghcr.io/coollabsio/minio:RELEASE.2025-10-15T17-29-55Z
    command: ["server", "/data", "--console-address", ":9001"]
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?Set MINIO_ROOT_USER in .env}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?Set MINIO_ROOT_PASSWORD in .env}
      MINIO_BROWSER: "off"
    volumes:
      - minio_data:/data
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 5s
      retries: 12
    restart: unless-stopped
    networks:
      - storage

  minio-init:
    image: ghcr.io/coollabsio/minio:RELEASE.2025-10-15T17-29-55Z
    entrypoint: ["/bin/sh", "/init-minio.sh"]
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?Set MINIO_ROOT_USER in .env}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?Set MINIO_ROOT_PASSWORD in .env}
      MINIO_PROFILE_BUCKET: ${MINIO_PROFILE_BUCKET:?Set MINIO_PROFILE_BUCKET in .env}
      MINIO_PROFILE_ACCESS_KEY: ${MINIO_PROFILE_ACCESS_KEY:?Set MINIO_PROFILE_ACCESS_KEY in .env}
      MINIO_PROFILE_SECRET_KEY: ${MINIO_PROFILE_SECRET_KEY:?Set MINIO_PROFILE_SECRET_KEY in .env}
    volumes:
      - ./minio-init.sh:/init-minio.sh:ro
    depends_on:
      minio:
        condition: service_healthy
    networks:
      - storage


  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?Set POSTGRES_DB in .env}
      POSTGRES_USER: ${POSTGRES_USER:?Set POSTGRES_USER in .env}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}
    ports:
      - "127.0.0.1:${POSTGRES_PORT:?Set POSTGRES_PORT in .env}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    networks:
      - app

  # ---------- Judge0 ----------
  judge0-server:
    image: mrkushalsm/judge0:cgv2
    user: "0:0"
    entrypoint: ["/bin/bash", "/usr/local/bin/coderush-judge0-entrypoint.sh"]
    command: ["./scripts/server"]
    volumes:
      - ./judge0.conf:/judge0.conf:ro
      - ./judge0-entrypoint.sh:/usr/local/bin/coderush-judge0-entrypoint.sh:ro
    ports:
      - "127.0.0.1:${JUDGE0_PORT:-2358}:2358"
    privileged: true
    <<: *default-logging
    restart: always
    depends_on:
      judge0-db:
        condition: service_healthy
      judge0-redis:
        condition: service_healthy
    networks:
      - app

  judge0-workers:
    image: mrkushalsm/judge0:cgv2
    user: "0:0"
    entrypoint: ["/bin/bash", "/usr/local/bin/coderush-judge0-entrypoint.sh"]
    command: ["./scripts/workers"]
    volumes:
      - ./judge0.conf:/judge0.conf:ro
      - ./judge0-entrypoint.sh:/usr/local/bin/coderush-judge0-entrypoint.sh:ro
    privileged: true
    <<: *default-logging
    restart: always
    depends_on:
      judge0-db:
        condition: service_healthy
      judge0-redis:
        condition: service_healthy
    networks:
      - app

  judge0-db:
    image: postgres:13.0
    env_file: judge0.conf
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - judge0_postgres_data:/var/lib/postgresql/data/
    <<: *default-logging
    restart: always
    networks:
      - app

  judge0-redis:
    image: redis:6.0
    command: [
      "bash", "-c",
      'docker-entrypoint.sh --appendonly yes --requirepass "$$REDIS_PASSWORD"'
    ]
    env_file: judge0.conf
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"$$REDIS_PASSWORD\" redis-cli ping"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - judge0_redis_data:/data
    <<: *default-logging
    restart: always
    networks:
      - app

volumes:
  frontend_certs:
  minio_data:
  postgres_data:
  judge0_postgres_data:
  judge0_redis_data:

networks:
  app:
    driver: bridge
  storage:
    internal: true
