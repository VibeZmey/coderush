  plugins: [react()],
  server: { proxy: { '/api': { target: loadEnv(mode, '.', 'VITE_').VITE_API_PROXY_TARGET || 'https://localhost:8443', changeOrigin: false, secure: false } } },
  build: { chunkSizeWarningLimit: 700 },
