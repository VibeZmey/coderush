ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
API_PORT=18080
FRONTEND_PORT=8443

POSTGRES_DB=coderush
POSTGRES_USER=coderush
POSTGRES_PASSWORD=coderush_local
POSTGRES_PORT=15432

ConnectionStrings__DefaultConnection="Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

# Set unique credentials before starting Compose.
MINIO_ROOT_USER=coderush-admin
MINIO_ROOT_PASSWORD=
MINIO_PROFILE_BUCKET=coderush-profile-media
MINIO_PROFILE_ACCESS_KEY=coderush-profile-api
MINIO_PROFILE_SECRET_KEY=
